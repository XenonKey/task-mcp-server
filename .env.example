# Cognito
AWS_REGION=eu-north-1
COGNITO_USER_POOL_ID=<your-user-pool-id>
COGNITO_APP_CLIENT_ID=<your-app-client-id>

# MCP resource server (API Gateway) — the origin your stack is reachable at,
# without a path. Only known after the first `sam deploy`, see README.
MCP_RESOURCE_SERVER_URL=<https://your-api-id.execute-api.your-region.amazonaws.com>

# task-service this MCP server wraps
TASK_API_BASE=<https://your-task-api.example.com/tasks>
